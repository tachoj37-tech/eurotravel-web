# Variables de entorno — se configuran en Vercel, NUNCA en este repositorio
#
# Vercel → proyecto eurotravel-web → Settings → Environment Variables
#
# OJO: Vercel solo aplica las variables a los despliegues NUEVOS. Después de
# agregar o cambiar una, hay que volver a desplegar (Deployments → el último →
# Redeploy). Si no, el sitio sigue corriendo con las de antes y parece que la
# variable "no sirvió".


# ---------------------------------------------------------------- Google ----

# Clave restringida a Places API (New), sin restriccion de sitio web
# (la usa el servidor, que no manda referer). Alimenta /api/places.
GOOGLE_PLACES_KEY=

# Clave restringida a Routes API, sin restriccion de sitio web.
# La usa /api/cotizar para medir los kilometros del viaje.
GOOGLE_ROUTES_KEY=


# ---------------------------------------------------------------- Stripe ----

# La clave secreta de Stripe. Con sk_test_ el cobro es de mentiras y sirve para
# probar el recorrido completo. Con sk_live_ el cobro es real, y ADEMAS hay que
# poner PERMITIR_COBRO_REAL en true dentro de api/pagar.js: mientras esa
# constante siga en false, una clave de produccion no cobra nada, la pantalla
# avisa y el viaje se cierra por telefono.
#   https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# El secreto de firma del webhook. Stripe lo entrega al dar de alta el endpoint
# https://eurotravel-web.vercel.app/api/webhook-stripe y empieza con whsec_.
# Sin el, /api/webhook-stripe contesta 500 y Stripe reintenta hasta tres dias:
# el pago no se pierde, pero el contrato no se registra hasta que se configure.
#   https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=


# ------------------------------------------------------------ EuroSystem ----

# La llave de la puerta de contratos. Es DE SERVIDOR A SERVIDOR: quien la vea
# puede registrar contratos a nombre de la empresa, asi que jamas va en codigo
# que llegue al navegador.
#
# Tiene que ser EL MISMO valor que la variable CONTRATOS_API_KEY del proyecto
# eurosystem. Si allá no está puesta, su endpoint contesta 503 y no registra
# nada — es a proposito: sin configurar, la puerta esta cerrada.
#
# Para generar una:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CONTRATOS_API_KEY=

# A donde se mandan los contratos. Opcional: si no se pone, se usa
# https://eurosystem-smoky.vercel.app
EUROSYSTEM_URL=
