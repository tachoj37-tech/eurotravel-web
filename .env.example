# Variables de entorno — se configuran en Vercel, NUNCA en este repositorio
#
# Vercel → proyecto eurotravel-web → Settings → Environment Variables
#
# Clave de Google restringida a Places API (New), sin restriccion de sitio web
# (la usa el servidor, que no manda referer). Alimenta /api/places.
GOOGLE_PLACES_KEY=

# Clave de Google restringida a Routes API, sin restriccion de sitio web.
# La usara /api/cotizar en la Fase 2 para calcular kilometros.
GOOGLE_ROUTES_KEY=
