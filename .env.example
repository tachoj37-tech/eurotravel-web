# Variables de entorno — se configuran en Vercel, NUNCA en este repositorio
#
# Vercel → proyecto eurotravel-web → Settings → Environment Variables
#
# OJO: Vercel solo aplica las variables a los despliegues NUEVOS. Después de
# agregar o cambiar una, hay que volver a desplegar (Deployments → el último →
# Redeploy). Si no, el sitio sigue corriendo con las de antes y parece que la
# variable "no sirvió".


# ---------------------------------------------------------------- Google ----

# Clave restringida a Places API (New), sin restriccion de sitio web
# (la usa el servidor, que no manda referer). Alimenta /api/places.
GOOGLE_PLACES_KEY=

# Clave restringida a Routes API, sin restriccion de sitio web.
# La usa /api/cotizar para medir los kilometros del viaje.
GOOGLE_ROUTES_KEY=


# ---------------------------------------------------------------- Stripe ----

# La clave secreta de Stripe. Con sk_test_ el cobro es de mentiras y sirve para
# probar el recorrido completo. Con sk_live_ el cobro es real, y ADEMAS hay que
# poner PERMITIR_COBRO_REAL en true dentro de api/pagar.js: mientras esa
# constante siga en false, una clave de produccion no cobra nada, la pantalla
# avisa y el viaje se cierra por telefono.
#   https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# El secreto de firma del webhook. Stripe lo entrega al dar de alta el endpoint
# https://eurotravel-web.vercel.app/api/webhook-stripe y empieza con whsec_.
# Sin el, /api/webhook-stripe contesta 500 y Stripe reintenta hasta tres dias:
# el pago no se pierde, pero el contrato no se registra hasta que se configure.
#   https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=


# ------------------------------------------------------------ EuroSystem ----

# La llave de la puerta de contratos. Es DE SERVIDOR A SERVIDOR: quien la vea
# puede registrar contratos a nombre de la empresa, asi que jamas va en codigo
# que llegue al navegador.
#
# Tiene que ser EL MISMO valor que la variable CONTRATOS_API_KEY del proyecto
# eurosystem. Si allá no está puesta, su endpoint contesta 503 y no registra
# nada — es a proposito: sin configurar, la puerta esta cerrada.
#
# Para generar una:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CONTRATOS_API_KEY=

# A donde se mandan los contratos. Opcional: si no se pone, se usa
# https://eurosystem-smoky.vercel.app
EUROSYSTEM_URL=


# ------------------------------------------- Prueba del cotizador (TEMPORAL) ----

# La clave de /prueba-cotizador.html, la pantalla interna donde el dueño revisa
# como se arman los costos. Esa pantalla enseña la tarifa por kilometro, lo que
# vale la noche y lo que vale el dia de movimientos: todo lo que el resto del
# sitio esconde a proposito. Por eso pide clave.
#
# SIN ESTA VARIABLE LA PANTALLA NO ABRE. Es a proposito: una variable que
# alguien olvida poner no puede volverse una puerta abierta.
#
# Se borra junto con prueba-cotizador.html y api/prueba-cotizador.js cuando el
# dueño termine de revisar.
#
# Para generar una:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
CLAVE_COTIZADOR=

# Clave para /api/diagnostico. Esa puerta dice si Stripe está en producción,
# cuánto miden las claves, y gasta cuota de Google y correos — la cabecera de
# origen no la protege de curl. Va con clave y FALLA CERRADA: sin esta
# variable, el diagnóstico no abre para nadie. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
CLAVE_DIAGNOSTICO=


# ----------------------------------------------- El correo al cliente ----

# Resend. Con esto el cliente recibe, al pagar, su folio, sus montos y su
# contrato en PDF adjunto. SIN esta variable el contrato se sigue registrando
# en EuroSystem —no se pierde nada— pero al cliente no le llega nada, y la
# pantalla le promete que si.
#
# Se saca en https://resend.com/api-keys
#
# ANTES DEL PRIMER CLIENTE REAL: hay que verificar el dominio
# eurotravel.com.mx en Resend. Sin dominio verificado, Resend SOLO entrega al
# dueño de la cuenta y rechaza a cualquier otro destinatario: el envio muere
# con un 403 y parece que el codigo esta roto. Para probar hoy con tu propio
# correo funciona sin verificar.
RESEND_API_KEY=

# De quien sale el correo. Opcional: si no se pone, sale de
# "Eurotravel <ventas@eurotravel.com.mx>", que solo sirve con el dominio
# eurotravel.com.mx ya verificado en Resend.
#
# MIENTRAS NO ESTE VERIFICADO, usa el remitente de prueba de Resend:
#
#   RESEND_DE=Eurotravel <onboarding@resend.dev>
#
# Funciona de inmediato sin verificar nada, PERO solo entrega al correo de tu
# propia cuenta de Resend —a cualquier otro le contesta 403—. O sea que sirve
# para los avisos a la oficina y para probar con tu propio correo, y NO sirve
# para escribirle a un cliente.
RESEND_DE=

# Firma las ligas propias de cada cliente —la del boton «Ver mi viaje» del
# correo—. SIN esta variable el correo sale igual, con folio y contrato
# adjunto, pero SIN boton: el cliente no puede entrar a ver su viaje en linea.
#
# Se genera una vez y no se vuelve a tocar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# CAMBIARLA INVALIDA TODAS LAS LIGAS YA MANDADAS. Los clientes que ya tienen
# su correo dejarian de poder entrar.
LIGAS_SECRETO=

# A quien le llegan los avisos que una persona tiene que atender HOY: un
# reembolso, un contracargo, un contrato que se cayo. Varios correos separados
# por coma. Si no se pone, llegan al mismo remitente (ventas@eurotravel.com.mx).
#
# Un aviso de reversa que no se manda es dinero que se pierde en silencio.
AVISOS_A=
