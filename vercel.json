{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/inicio",
      "destination": "/#/inicio",
      "permanent": true
    },
    {
      "source": "/contacto",
      "destination": "/#/contacto",
      "permanent": true
    },
    {
      "source": "/cotizacion-en-linea",
      "destination": "/#/cotizar",
      "permanent": true
    },
    {
      "source": "/empresariales",
      "destination": "/#/cotizar",
      "permanent": true
    },
    {
      "source": "/sobre-nosotros",
      "destination": "/#/nosotros",
      "permanent": true
    },
    {
      "source": "/renta",
      "destination": "/#/unidades",
      "permanent": true
    },
    {
      "source": "/renta/autobuses",
      "destination": "/#/unidades",
      "permanent": true
    },
    {
      "source": "/renta/autobuses/:cual",
      "destination": "/#/unidades",
      "permanent": true
    },
    {
      "source": "/renta/sprinter",
      "destination": "/#/unidades",
      "permanent": true
    },
    {
      "source": "/renta/suburban-3",
      "destination": "/#/unidades",
      "permanent": true
    },
    {
      "source": "/pagos-en-linea",
      "destination": "/viaje.html",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/comments/feed",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-json/:resto*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-admin/:resto*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/whatsapp/:llave",
      "destination": "/api/whatsapp?llave=:llave"
    }
  ],
  "crons": [
    {
      "path": "/api/whatsapp/seguimiento",
      "schedule": "*/15 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://lh3.googleusercontent.com; connect-src 'self' https://accounts.google.com/gsi/ https://o4512003711041536.ingest.us.sentry.io; frame-src https://accounts.google.com/gsi/; form-action 'self' https://checkout.stripe.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        }
      ]
    }
  ]
}
